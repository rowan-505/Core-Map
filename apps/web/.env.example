# Copy to apps/web/.env.local (and optionally apps/web/.env).
# Public map only. No database URLs. No secrets.

VITE_API_BASE_URL=http://localhost:3001
VITE_MARTIN_TILE_URL=http://localhost:3002
VITE_BASEMAP_MANIFEST_URL=/basemaps/manifest.json

# DEV-only local PMTiles QA (never enable in production builds).
# Prefer: Terminal 1 `npm run tiles:serve` + Terminal 2 `npm run tiles:qa:web`
# Default QA = production parity (localhost overview + viewport regions).
# Stress all packages: open ?qaPackage=all
# Overview file: npm run tiles:fetch:overview
# VITE_LOAD_ALL_LOCAL_REGION_PMTILES=true
