# Copy to apps/dashboard/.env.local
# Dashboard is an API client only. No database URLs.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Martin vector tiles (Places / Transport). Hosted default is fine for local Dev Map.
NEXT_PUBLIC_TILE_SERVER_URL=https://martin-lively-canyon-4077.fly.dev
# Public CDN basemap (preferred). Avoids needing a local tiles:serve on :8080.
NEXT_PUBLIC_BASEMAP_PMTILES_URL=https://tiles.coremapmm.com/basemaps/yangon/v2/basemap.pmtiles
NEXT_PUBLIC_OVERVIEW_PMTILES_URL=https://tiles.coremapmm.com/basemaps/overview/v2/myanmar-overview-v2.pmtiles
NEXT_PUBLIC_LOCAL_REGION_PMTILES_BASE_URL=https://tiles.coremapmm.com/basemaps

# Leave empty unless you also set the same token on the API.

# Local Basemap + Dev Map UI (non-production only).
# Also set API ENABLE_LOCAL_BASEMAP_ADMIN=true + LOCAL_TILE_DATABASE_URL.
NEXT_PUBLIC_ENABLE_LOCAL_BASEMAP_ADMIN=true
# Optional: NEXT_PUBLIC_ENABLE_DEV_MAP=true
