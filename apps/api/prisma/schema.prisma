generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "app_auth", "contrib", "core", "ref", "system"]
}

model AuthUser {
  id                BigInt    @id @default(autoincrement())
  publicId          String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  email             String    @unique @db.Text
  passwordHash      String?   @map("password_hash") @db.Text
  displayName       String    @map("display_name") @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  phone             String?   @db.Text
  emailVerified     Boolean   @default(false) @map("email_verified")
  accountStatus     String    @default("active") @map("account_status") @db.Text
  primaryRegionId   BigInt?   @map("primary_region_id")
  preferredLanguage String    @default("my") @map("preferred_language") @db.Text
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  adminNote         String?   @map("admin_note") @db.Text

  userRoles             AuthUserRole[]
  sessions              AuthSession[]
  identities            AuthIdentity[]
  emailVerificationOtps EmailVerificationOtp[]
  passwordResetTokens   PasswordResetToken[]
  securityEvents        AuthSecurityEvent[]
  mfaMethods            AuthMfaMethod[]
  savedPlaces           UserSavedPlace[]
  pointLedgerEntries    PointLedger[]          @relation("PointLedgerUser")
  pointLedgerCreated    PointLedger[]          @relation("PointLedgerCreatedBy")
  pointSummary          UserPointSummary?
  auditLogs             AuditLog[]

  @@map("auth_users")
  @@schema("app_auth")
}

model AuthRole {
  id          BigInt         @id @default(autoincrement())
  code        String         @unique @db.Text
  name        String         @unique @db.Text
  description String?        @db.Text
  isSystem    Boolean        @default(true) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  userRoles   AuthUserRole[]

  @@map("auth_roles")
  @@schema("app_auth")
}

model AuthUserRole {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  roleId     BigInt   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       AuthUser @relation(fields: [userId], references: [id])
  role       AuthRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId], map: "auth_user_roles_user_id_role_id_key")
  @@map("auth_user_roles")
  @@schema("app_auth")
}

model AuthSession {
  id                       BigInt    @id @default(autoincrement())
  publicId                 String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId                   BigInt    @map("user_id")
  refreshTokenHash         String    @unique @map("refresh_token_hash") @db.Text
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.Text
  tokenFamilyId            String    @default(dbgenerated("gen_random_uuid()")) @map("token_family_id") @db.Uuid
  userAgent                String?   @map("user_agent") @db.Text
  ipAddress                String?   @map("ip_address") @db.Text
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt            DateTime? @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt        DateTime? @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason             String?   @map("revoke_reason") @db.Text
  clientType               String    @default("web") @map("client_type") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime? @map("last_used_at") @db.Timestamptz(6)
  user                     AuthUser  @relation(fields: [userId], references: [id])
  securityEvents           AuthSecurityEvent[]

  @@map("auth_sessions")
  @@schema("app_auth")
}

model AuthIdentity {
  id                    BigInt    @id @default(autoincrement())
  publicId              String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId                BigInt    @map("user_id")
  provider              String    @db.Text
  providerSubject       String    @map("provider_subject") @db.Text
  providerEmail         String?   @map("provider_email") @db.Text
  providerEmailVerified Boolean   @default(false) @map("provider_email_verified")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  user                  AuthUser  @relation(fields: [userId], references: [id])

  @@unique([provider, providerSubject], map: "auth_identities_provider_subject_key")
  @@map("auth_identities")
  @@schema("app_auth")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AuthUser  @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
  @@schema("app_auth")
}

model AuthSecurityEvent {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt?      @map("user_id")
  sessionId BigInt?      @map("session_id")
  eventType String       @map("event_type") @db.Text
  provider  String?      @db.Text
  success   Boolean      @default(true)
  ipAddress String?      @map("ip_address") @db.Text
  userAgent String?      @map("user_agent") @db.Text
  metadata  Json?        @db.JsonB
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AuthUser?    @relation(fields: [userId], references: [id])
  session   AuthSession? @relation(fields: [sessionId], references: [id])

  @@map("auth_security_events")
  @@schema("app_auth")
}

model OAuthState {
  id                   BigInt    @id @default(autoincrement())
  stateHash            String    @unique @map("state_hash") @db.Text
  codeVerifierHash     String?   @map("code_verifier_hash") @db.Text
  nonceHash            String?   @map("nonce_hash") @db.Text
  client               String    @default("web") @db.Text
  returnTo             String?   @map("return_to") @db.Text
  purpose              String    @default("login") @db.Text
  linkUserId           BigInt?   @map("link_user_id")
  linkSessionPublicId  String?   @map("link_session_public_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("oauth_states")
  @@schema("app_auth")
}

model OAuthPendingRegistration {
  id                    BigInt    @id @default(autoincrement())
  publicId              String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  tokenHash             String    @unique @map("token_hash") @db.Text
  provider              String    @db.Text
  providerSubject       String    @map("provider_subject") @db.Text
  providerName          String?   @map("provider_name") @db.Text
  providerEmail         String?   @map("provider_email") @db.Text
  providerEmailVerified Boolean   @default(false) @map("provider_email_verified")
  client                String    @default("web") @db.Text
  returnTo              String?   @map("return_to") @db.Text
  emailPending          String?   @map("email_pending") @db.Text
  otpHash               String?   @map("otp_hash") @db.Text
  otpExpiresAt          DateTime? @map("otp_expires_at") @db.Timestamptz(6)
  otpAttemptsCount      Int       @default(0) @map("otp_attempts_count")
  otpMaxAttempts        Int       @default(5) @map("otp_max_attempts")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("oauth_pending_registrations")
  @@schema("app_auth")
}

model AuthMfaMethod {
  id               BigInt                 @id @default(autoincrement())
  publicId         String                 @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId           BigInt                 @map("user_id")
  method           String                 @default("totp") @db.Text
  secretEncrypted  String                 @map("secret_encrypted") @db.Text
  verifiedAt       DateTime?              @map("verified_at") @db.Timestamptz(6)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user             AuthUser               @relation(fields: [userId], references: [id])
  recoveryCodes    AuthMfaRecoveryCode[]

  @@map("auth_mfa_methods")
  @@schema("app_auth")
}

model AuthMfaRecoveryCode {
  id        BigInt        @id @default(autoincrement())
  methodId  BigInt        @map("method_id")
  codeHash  String        @map("code_hash") @db.Text
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  method    AuthMfaMethod @relation(fields: [methodId], references: [id])

  @@map("auth_mfa_recovery_codes")
  @@schema("app_auth")
}

model EmailVerificationOtp {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  email         String    @db.Text
  otpHash       String    @map("otp_hash") @db.Text
  purpose       String    @default("email_verification") @db.Text
  attemptsCount Int       @default(0) @map("attempts_count")
  maxAttempts   Int       @default(5) @map("max_attempts")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          AuthUser  @relation(fields: [userId], references: [id])

  @@map("email_verification_otps")
  @@schema("app_auth")
}

model UserSavedPlace {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  entityType  String   @map("entity_type") @db.Text
  // Required for entity_type='place'; NULL for 'map_point' (DB CHECK enforces this).
  entityId    BigInt?  @map("entity_id")
  customName  String?  @map("custom_name") @db.Text
  note        String?  @db.Text
  adminAreaId BigInt?  @map("admin_area_id")
  // Map-point saves store their own coordinates / address. geom is set via raw SQL
  // (ST_MakePoint) and is intentionally not modelled here (PostGIS type).
  latitude    Float?   @db.DoublePrecision
  longitude   Float?   @db.DoublePrecision
  addressLine String?  @map("address_line") @db.Text
  plusCode    String?  @map("plus_code") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        AuthUser @relation(fields: [userId], references: [id])

  // Partial unique (user_id, entity_id) WHERE entity_type='place' is enforced in SQL
  // (migration 111); Prisma still surfaces the violation as P2002 on insert.
  @@map("user_saved_places")
  @@schema("app")
}

model PointLedger {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @map("user_id")
  pointsDelta       Int       @map("points_delta")
  reasonCode        String    @map("reason_code") @db.Text
  relatedEntityType String?   @map("related_entity_type") @db.Text
  relatedEntityId   BigInt?   @map("related_entity_id")
  note              String?   @db.Text
  createdBy         BigInt?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              AuthUser  @relation("PointLedgerUser", fields: [userId], references: [id])
  creator           AuthUser? @relation("PointLedgerCreatedBy", fields: [createdBy], references: [id])

  @@map("point_ledger")
  @@schema("contrib")
}

model UserPointSummary {
  userId                BigInt   @id @map("user_id")
  totalPoints           Int      @default(0) @map("total_points")
  lifetimePointsEarned  Int      @default(0) @map("lifetime_points_earned")
  lifetimePointsRemoved Int      @default(0) @map("lifetime_points_removed")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  AuthUser @relation(fields: [userId], references: [id])

  @@map("user_point_summary")
  @@schema("contrib")
}

model AuditLog {
  id             BigInt    @id @default(autoincrement())
  actorUserId    BigInt?   @map("actor_user_id")
  actionType     String    @map("action_type") @db.Text
  entityType     String    @map("entity_type") @db.Text
  entityId       BigInt?   @map("entity_id")
  beforeSnapshot Json?     @map("before_snapshot") @db.JsonB
  afterSnapshot  Json?     @map("after_snapshot") @db.JsonB
  ipAddress      String?   @map("ip_address") @db.Text
  userAgent      String?   @map("user_agent") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          AuthUser? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
  @@schema("system")
}

model RefPoiCategory {
  id           BigInt   @id @default(autoincrement())
  parentId     BigInt?  @map("parent_id")
  code         String   @unique @db.Text
  name         String   @unique @db.Text
  sortOrder    Int      @map("sort_order")
  isSearchable Boolean  @default(true) @map("is_searchable")
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ref_poi_categories")
  @@schema("ref")
}

model RefBuildingType {
  id        BigInt            @id @default(autoincrement())
  code      String            @unique @db.Text
  name      String            @db.Text
  nameMm    String?           @map("name_mm") @db.Text
  parentId  BigInt?           @map("parent_id")
  sortOrder Int               @default(0) @map("sort_order")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent    RefBuildingType?  @relation("RefBuildingTypeHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  RefBuildingType[] @relation("RefBuildingTypeHierarchy")

  @@map("ref_building_types")
  @@schema("ref")
}

model CoreAdminArea {
  id            BigInt   @id @default(autoincrement())
  publicId      String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  parentId      BigInt?  @map("parent_id")
  adminLevelId  BigInt   @map("admin_level_id")
  canonicalName String   @map("canonical_name") @db.Text
  slug          String   @unique @db.Text
  sourceTypeId  BigInt   @map("source_type_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("core_admin_areas")
  @@schema("core")
}

model CorePlace {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  primaryName      String    @map("primary_name") @db.Text
  displayName      String    @map("display_name") @db.Text
  categoryId       BigInt    @map("category_id")
  adminAreaId      BigInt?   @map("admin_area_id")
  lat              Float
  lng              Float
  plusCode         String?   @map("plus_code") @db.Text
  importanceScore  Decimal   @default(0) @map("importance_score") @db.Decimal
  popularityScore  Decimal   @default(0) @map("popularity_score") @db.Decimal
  confidenceScore  Decimal   @default(0) @map("confidence_score") @db.Decimal
  isPublic         Boolean   @default(true) @map("is_public")
  isVerified       Boolean   @default(false) @map("is_verified")
  sourceTypeId     BigInt    @map("source_type_id")
  publishStatusId  BigInt?   @map("publish_status_id")
  currentVersionId BigInt?   @map("current_version_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("core_places")
  @@schema("core")
}
