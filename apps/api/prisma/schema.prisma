generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "app_auth", "community", "contrib", "core", "ref", "system", "tourism"]
}

model AuthUser {
  id                BigInt    @id @default(autoincrement())
  publicId          String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  email             String    @unique @db.Text
  passwordHash      String?   @map("password_hash") @db.Text
  displayName       String    @map("display_name") @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  phone             String?   @db.Text
  emailVerified     Boolean   @default(false) @map("email_verified")
  accountStatus     String    @default("active") @map("account_status") @db.Text
  primaryRegionId   BigInt?   @map("primary_region_id")
  preferredLanguage String    @default("my") @map("preferred_language") @db.Text
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  adminNote         String?   @map("admin_note") @db.Text

  userRoles             AuthUserRole[]
  sessions              AuthSession[]
  identities            AuthIdentity[]
  emailVerificationOtps EmailVerificationOtp[]
  passwordResetTokens   PasswordResetToken[]
  securityEvents        AuthSecurityEvent[]
  mfaMethods            AuthMfaMethod[]
  savedPlaces           UserSavedPlace[]
  pointLedgerEntries    PointLedger[]          @relation("PointLedgerUser")
  pointLedgerCreated    PointLedger[]          @relation("PointLedgerCreatedBy")
  pointSummary          UserPointSummary?
  auditLogs             AuditLog[]
  communityPosts        CommunityPost[]              @relation("CommunityPostAuthor")
  communityReactions    CommunityPostReaction[]      @relation("CommunityReactionUser")
  communityNotifications CommunityNotification[]     @relation("CommunityNotificationRecipient")
  communityNotificationsActed CommunityNotification[] @relation("CommunityNotificationActor")
  communityModerationEvents CommunityPostModerationEvent[] @relation("CommunityModerationActor")
  tourismProfilesCreated    TourismPlaceProfile[]            @relation("TourismProfileCreatedBy")
  tourismProfilesUpdated    TourismPlaceProfile[]            @relation("TourismProfileUpdatedBy")
  tourismCandidateIgnores   TourismPlaceCandidateIgnore[]    @relation("TourismCandidateIgnoredBy")
  tourismActivitiesCreated  TourismActivity[]                @relation("TourismActivityCreatedBy")
  tourismActivitiesUpdated  TourismActivity[]                @relation("TourismActivityUpdatedBy")
  tourismEventsCreated      TourismEvent[]                   @relation("TourismEventCreatedBy")
  tourismEventsUpdated      TourismEvent[]                   @relation("TourismEventUpdatedBy")
  tourismEventOccurrencesCreated TourismEventOccurrence[]    @relation("TourismEventOccurrenceCreatedBy")
  tourismEventOccurrencesUpdated TourismEventOccurrence[]    @relation("TourismEventOccurrenceUpdatedBy")
  tourismFoodsCreated            TourismFood[]               @relation("TourismFoodCreatedBy")
  tourismFoodsUpdated            TourismFood[]               @relation("TourismFoodUpdatedBy")
  tourismLocalGuidesCreated      TourismLocalGuide[]         @relation("TourismLocalGuideCreatedBy")
  tourismLocalGuidesUpdated      TourismLocalGuide[]         @relation("TourismLocalGuideUpdatedBy")
  tourismAdvisoriesCreated       TourismAdvisory[]           @relation("TourismAdvisoryCreatedBy")
  tourismAdvisoriesUpdated       TourismAdvisory[]           @relation("TourismAdvisoryUpdatedBy")
  tourismResearchCandidatesReviewed TourismResearchCandidate[] @relation("TourismResearchCandidateReviewedBy")
  communityPlaceReviews     CommunityPlaceReview[]           @relation("CommunityPlaceReviewAuthor")
  communityReviewModerationEvents CommunityReviewModerationEvent[] @relation("CommunityReviewModerationActor")

  @@map("auth_users")
  @@schema("app_auth")
}

model AuthRole {
  id          BigInt         @id @default(autoincrement())
  code        String         @unique @db.Text
  name        String         @unique @db.Text
  description String?        @db.Text
  isSystem    Boolean        @default(true) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  userRoles   AuthUserRole[]

  @@map("auth_roles")
  @@schema("app_auth")
}

model AuthUserRole {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  roleId     BigInt   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       AuthUser @relation(fields: [userId], references: [id])
  role       AuthRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId], map: "auth_user_roles_user_id_role_id_key")
  @@map("auth_user_roles")
  @@schema("app_auth")
}

model AuthSession {
  id                       BigInt    @id @default(autoincrement())
  publicId                 String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId                   BigInt    @map("user_id")
  refreshTokenHash         String    @unique @map("refresh_token_hash") @db.Text
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.Text
  tokenFamilyId            String    @default(dbgenerated("gen_random_uuid()")) @map("token_family_id") @db.Uuid
  userAgent                String?   @map("user_agent") @db.Text
  ipAddress                String?   @map("ip_address") @db.Text
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt            DateTime? @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt        DateTime? @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason             String?   @map("revoke_reason") @db.Text
  clientType               String    @default("web") @map("client_type") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime? @map("last_used_at") @db.Timestamptz(6)
  user                     AuthUser  @relation(fields: [userId], references: [id])
  securityEvents           AuthSecurityEvent[]

  @@map("auth_sessions")
  @@schema("app_auth")
}

model AuthIdentity {
  id                    BigInt    @id @default(autoincrement())
  publicId              String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId                BigInt    @map("user_id")
  provider              String    @db.Text
  providerSubject       String    @map("provider_subject") @db.Text
  providerEmail         String?   @map("provider_email") @db.Text
  providerEmailVerified Boolean   @default(false) @map("provider_email_verified")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  user                  AuthUser  @relation(fields: [userId], references: [id])

  @@unique([provider, providerSubject], map: "auth_identities_provider_subject_key")
  @@map("auth_identities")
  @@schema("app_auth")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AuthUser  @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
  @@schema("app_auth")
}

model AuthSecurityEvent {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt?      @map("user_id")
  sessionId BigInt?      @map("session_id")
  eventType String       @map("event_type") @db.Text
  provider  String?      @db.Text
  success   Boolean      @default(true)
  ipAddress String?      @map("ip_address") @db.Text
  userAgent String?      @map("user_agent") @db.Text
  metadata  Json?        @db.JsonB
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AuthUser?    @relation(fields: [userId], references: [id])
  session   AuthSession? @relation(fields: [sessionId], references: [id])

  @@map("auth_security_events")
  @@schema("app_auth")
}

model OAuthState {
  id                   BigInt    @id @default(autoincrement())
  stateHash            String    @unique @map("state_hash") @db.Text
  codeVerifierHash     String?   @map("code_verifier_hash") @db.Text
  nonceHash            String?   @map("nonce_hash") @db.Text
  client               String    @default("web") @db.Text
  returnTo             String?   @map("return_to") @db.Text
  purpose              String    @default("login") @db.Text
  linkUserId           BigInt?   @map("link_user_id")
  linkSessionPublicId  String?   @map("link_session_public_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("oauth_states")
  @@schema("app_auth")
}

model OAuthPendingRegistration {
  id                    BigInt    @id @default(autoincrement())
  publicId              String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  tokenHash             String    @unique @map("token_hash") @db.Text
  provider              String    @db.Text
  providerSubject       String    @map("provider_subject") @db.Text
  providerName          String?   @map("provider_name") @db.Text
  providerEmail         String?   @map("provider_email") @db.Text
  providerEmailVerified Boolean   @default(false) @map("provider_email_verified")
  client                String    @default("web") @db.Text
  returnTo              String?   @map("return_to") @db.Text
  emailPending          String?   @map("email_pending") @db.Text
  otpHash               String?   @map("otp_hash") @db.Text
  otpExpiresAt          DateTime? @map("otp_expires_at") @db.Timestamptz(6)
  otpAttemptsCount      Int       @default(0) @map("otp_attempts_count")
  otpMaxAttempts        Int       @default(5) @map("otp_max_attempts")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("oauth_pending_registrations")
  @@schema("app_auth")
}

model AuthMfaMethod {
  id               BigInt                 @id @default(autoincrement())
  publicId         String                 @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId           BigInt                 @map("user_id")
  method           String                 @default("totp") @db.Text
  secretEncrypted  String                 @map("secret_encrypted") @db.Text
  verifiedAt       DateTime?              @map("verified_at") @db.Timestamptz(6)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user             AuthUser               @relation(fields: [userId], references: [id])
  recoveryCodes    AuthMfaRecoveryCode[]

  @@map("auth_mfa_methods")
  @@schema("app_auth")
}

model AuthMfaRecoveryCode {
  id        BigInt        @id @default(autoincrement())
  methodId  BigInt        @map("method_id")
  codeHash  String        @map("code_hash") @db.Text
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  method    AuthMfaMethod @relation(fields: [methodId], references: [id])

  @@map("auth_mfa_recovery_codes")
  @@schema("app_auth")
}

model EmailVerificationOtp {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  email         String    @db.Text
  otpHash       String    @map("otp_hash") @db.Text
  purpose       String    @default("email_verification") @db.Text
  attemptsCount Int       @default(0) @map("attempts_count")
  maxAttempts   Int       @default(5) @map("max_attempts")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          AuthUser  @relation(fields: [userId], references: [id])

  @@map("email_verification_otps")
  @@schema("app_auth")
}

model UserSavedPlace {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  entityType  String   @map("entity_type") @db.Text
  // Required for entity_type='place'; NULL for 'map_point' (DB CHECK enforces this).
  entityId    BigInt?  @map("entity_id")
  customName  String?  @map("custom_name") @db.Text
  note        String?  @db.Text
  adminAreaId BigInt?  @map("admin_area_id")
  // Map-point saves store their own coordinates / address. geom is set via raw SQL
  // (ST_MakePoint) and is intentionally not modelled here (PostGIS type).
  latitude    Float?   @db.DoublePrecision
  longitude   Float?   @db.DoublePrecision
  addressLine String?  @map("address_line") @db.Text
  plusCode    String?  @map("plus_code") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        AuthUser @relation(fields: [userId], references: [id])

  // Partial unique (user_id, entity_id) WHERE entity_type='place' is enforced in SQL
  // (migration 111); Prisma still surfaces the violation as P2002 on insert.
  @@map("user_saved_places")
  @@schema("app")
}

/// Daily place engagement counters for contextual popularity (Phase 3).
/// Do not treat as a global popularity score store.
model PlaceActivityDaily {
  placeId          BigInt   @map("place_id")
  activityDate     DateTime @map("activity_date") @db.Date
  viewCount        Int      @default(0) @map("view_count")
  saveCount        Int      @default(0) @map("save_count")
  shareCount       Int      @default(0) @map("share_count")
  directionsCount  Int      @default(0) @map("directions_count")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([placeId, activityDate])
  @@unique([placeId, activityDate], map: "place_activity_daily_place_date_uidx")
  @@index([activityDate(sort: Desc)], map: "place_activity_daily_date_idx")
  @@index([placeId, activityDate(sort: Desc)], map: "place_activity_daily_place_date_desc_idx")
  @@map("place_activity_daily")
  @@schema("app")
}

model PointLedger {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @map("user_id")
  pointsDelta       Int       @map("points_delta")
  reasonCode        String    @map("reason_code") @db.Text
  relatedEntityType String?   @map("related_entity_type") @db.Text
  relatedEntityId   BigInt?   @map("related_entity_id")
  note              String?   @db.Text
  createdBy         BigInt?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              AuthUser  @relation("PointLedgerUser", fields: [userId], references: [id])
  creator           AuthUser? @relation("PointLedgerCreatedBy", fields: [createdBy], references: [id])

  @@map("point_ledger")
  @@schema("contrib")
}

model UserPointSummary {
  userId                BigInt   @id @map("user_id")
  totalPoints           Int      @default(0) @map("total_points")
  lifetimePointsEarned  Int      @default(0) @map("lifetime_points_earned")
  lifetimePointsRemoved Int      @default(0) @map("lifetime_points_removed")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  AuthUser @relation(fields: [userId], references: [id])

  @@map("user_point_summary")
  @@schema("contrib")
}

model AuditLog {
  id             BigInt    @id @default(autoincrement())
  actorUserId    BigInt?   @map("actor_user_id")
  actionType     String    @map("action_type") @db.Text
  entityType     String    @map("entity_type") @db.Text
  entityId       BigInt?   @map("entity_id")
  beforeSnapshot Json?     @map("before_snapshot") @db.JsonB
  afterSnapshot  Json?     @map("after_snapshot") @db.JsonB
  ipAddress      String?   @map("ip_address") @db.Text
  userAgent      String?   @map("user_agent") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          AuthUser? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
  @@schema("system")
}

model RefPoiCategory {
  id            BigInt   @id @default(autoincrement())
  parentId      BigInt?  @map("parent_id")
  code          String   @unique @db.Text
  name          String   @unique @db.Text
  sortOrder     Int      @map("sort_order")
  isSearchable  Boolean  @default(true) @map("is_searchable")
  isPublic      Boolean  @default(true) @map("is_public")
  rankingGroup  String?  @map("ranking_group") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ref_poi_categories")
  @@schema("ref")
}

model RefBuildingType {
  id        BigInt            @id @default(autoincrement())
  code      String            @unique @db.Text
  name      String            @db.Text
  nameMm    String?           @map("name_mm") @db.Text
  parentId  BigInt?           @map("parent_id")
  sortOrder Int               @default(0) @map("sort_order")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent    RefBuildingType?  @relation("RefBuildingTypeHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  RefBuildingType[] @relation("RefBuildingTypeHierarchy")

  @@map("ref_building_types")
  @@schema("ref")
}

model RefTourismType {
  id          BigInt                @id @default(autoincrement())
  code        String                @unique @db.Text
  nameEn      String                @map("name_en") @db.Text
  nameMm      String?               @map("name_mm") @db.Text
  description String?               @db.Text
  sortOrder   Int                   @default(0) @map("sort_order")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  profiles    TourismPlaceProfile[]

  @@index([isActive, sortOrder, id], map: "ref_tourism_types_active_sort_idx")
  @@map("ref_tourism_types")
  @@schema("ref")
}

model RefActivityType {
  id          BigInt            @id @default(autoincrement())
  code        String            @unique @db.Text
  nameEn      String            @map("name_en") @db.Text
  nameMm      String?           @map("name_mm") @db.Text
  description String?           @db.Text
  sortOrder   Int               @default(100) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  activities  TourismActivity[]

  @@index([isActive, sortOrder, id], map: "ref_activity_types_active_sort_idx")
  @@map("ref_activity_types")
  @@schema("ref")
}

model RefEventType {
  id          BigInt         @id @default(autoincrement())
  code        String         @unique @db.Text
  nameEn      String         @map("name_en") @db.Text
  nameMm      String?        @map("name_mm") @db.Text
  description String?        @db.Text
  sortOrder   Int            @default(100) @map("sort_order")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  events      TourismEvent[]

  @@index([isActive, sortOrder, id], map: "ref_event_types_active_sort_idx")
  @@map("ref_event_types")
  @@schema("ref")
}

model CoreAdminArea {
  id            BigInt   @id @default(autoincrement())
  publicId      String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  parentId      BigInt?  @map("parent_id")
  adminLevelId  BigInt   @map("admin_level_id")
  canonicalName String   @map("canonical_name") @db.Text
  slug          String   @unique @db.Text
  sourceTypeId  BigInt   @map("source_type_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tourismActivities          TourismActivity[]
  tourismEvents              TourismEvent[]
  tourismFoods               TourismFood[]
  tourismLocalGuides         TourismLocalGuide[]
  tourismAdvisories          TourismAdvisory[]
  tourismResearchCandidates  TourismResearchCandidate[]

  @@map("core_admin_areas")
  @@schema("core")
}

model CorePlace {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  primaryName      String    @map("primary_name") @db.Text
  displayName      String    @map("display_name") @db.Text
  categoryId       BigInt    @map("category_id")
  adminAreaId      BigInt?   @map("admin_area_id")
  lat              Float
  lng              Float
  plusCode         String?   @map("plus_code") @db.Text
  importanceScore  Decimal   @default(0) @map("importance_score") @db.Decimal
  popularityScore  Decimal   @default(0) @map("popularity_score") @db.Decimal
  confidenceScore  Decimal   @default(0) @map("confidence_score") @db.Decimal
  isPublic         Boolean   @default(true) @map("is_public")
  isVerified       Boolean   @default(false) @map("is_verified")
  sourceTypeId     BigInt    @map("source_type_id")
  publishStatusId  BigInt?   @map("publish_status_id")
  currentVersionId BigInt?   @map("current_version_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  tourismProfile           TourismPlaceProfile?
  tourismCandidateIgnore   TourismPlaceCandidateIgnore?
  tourismActivities        TourismActivity[]
  tourismEvents            TourismEvent[]
  tourismFoodPlaceLinks    TourismFoodPlaceLink[]
  tourismLocalGuides       TourismLocalGuide[]
  tourismAdvisories        TourismAdvisory[]
  communityPlaceReviews    CommunityPlaceReview[]
  communityRatingSummary   CommunityPlaceRatingSummary?

  @@map("core_places")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// community — local news posts, reactions, notifications, moderation history.
// Source of truth: infrastructure/database/migrations/supabase/
//   20260917010000_community_production_contract.sql
// Trust / auto-confirm rules are enforced in the API (not DB triggers).
// ---------------------------------------------------------------------------

enum CommunityPublicationStatus {
  published
  resolved
  expired
  rejected
  removed

  @@map("publication_status")
  @@schema("community")
}

enum CommunityVerificationStatus {
  unverified
  community_confirmed
  admin_verified

  @@map("verification_status")
  @@schema("community")
}

enum CommunityReactionType {
  confirm
  helpful
  incorrect

  @@map("reaction_type")
  @@schema("community")
}

enum CommunityNotificationType {
  community_confirmed
  admin_verified
  rejected
  resolved
  expired
  post_reaction
  post_community_confirmed
  post_admin_verified
  post_admin_unverified
  post_rejected
  post_resolved
  post_expired
  post_reopened
  moderation_message

  @@map("notification_type")
  @@schema("community")
}

model CommunityPost {
  id                  BigInt                       @id @default(autoincrement())
  publicId            String                       @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  authorId            BigInt                       @map("author_id")
  title               String                       @db.Text
  description         String                       @db.Text
  topic               String                       @db.Text
  publicationStatus   CommunityPublicationStatus   @default(published) @map("publication_status")
  verificationStatus  CommunityVerificationStatus  @default(unverified) @map("verification_status")
  trustScore          Int                          @default(0) @map("trust_score")
  location            Unsupported("geometry(Point, 4326)")?
  locationLabel       String?                      @map("location_label") @db.Text
  publishedAt         DateTime                     @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?                    @map("deleted_at") @db.Timestamptz(6)

  author              AuthUser                     @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reactions           CommunityPostReaction[]
  notifications       CommunityNotification[]
  moderationEvents    CommunityPostModerationEvent[]

  @@index([authorId], map: "community_posts_author_id_idx")
  @@index([publicationStatus], map: "community_posts_publication_status_idx")
  @@index([verificationStatus], map: "community_posts_verification_status_idx")
  @@map("community_posts")
  @@schema("community")
}

model CommunityPostReaction {
  id           BigInt                 @id @default(autoincrement())
  postId       BigInt                 @map("post_id")
  userId       BigInt                 @map("user_id")
  reactionType CommunityReactionType  @map("reaction_type")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)

  post         CommunityPost          @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         AuthUser               @relation("CommunityReactionUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([postId, userId], map: "post_reactions_post_id_user_id_key")
  @@index([postId], map: "post_reactions_post_id_idx")
  @@index([userId], map: "post_reactions_user_id_idx")
  @@map("post_reactions")
  @@schema("community")
}

model CommunityNotification {
  id            BigInt                     @id @default(autoincrement())
  publicId      String                     @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId        BigInt                     @map("user_id")
  actorUserId   BigInt?                    @map("actor_user_id")
  type          CommunityNotificationType
  reactionType  CommunityReactionType?     @map("reaction_type")
  title         String                     @db.Text
  message       String                     @db.Text
  relatedPostId BigInt?                    @map("related_post_id")
  eventKey      String?                    @map("event_key") @db.Text
  isRead        Boolean                    @default(false) @map("is_read")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?                  @map("deleted_at") @db.Timestamptz(6)

  user          AuthUser                   @relation("CommunityNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor         AuthUser?                  @relation("CommunityNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  relatedPost   CommunityPost?             @relation(fields: [relatedPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId], map: "notifications_user_id_idx")
  @@index([isRead], map: "notifications_is_read_idx")
  @@index([relatedPostId], map: "notifications_related_post_id_idx")
  @@index([actorUserId], map: "notifications_actor_user_id_idx")
  @@map("notifications")
  @@schema("community")
}

model CommunityPostModerationEvent {
  id                       BigInt                      @id @default(autoincrement())
  publicId                 String                      @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  postId                   BigInt                      @map("post_id")
  actorUserId              BigInt?                     @map("actor_user_id")
  actionCode               String                      @map("action_code") @db.Text
  fromPublicationStatus    CommunityPublicationStatus? @map("from_publication_status")
  toPublicationStatus      CommunityPublicationStatus? @map("to_publication_status")
  fromVerificationStatus   CommunityVerificationStatus? @map("from_verification_status")
  toVerificationStatus     CommunityVerificationStatus? @map("to_verification_status")
  note                     String?                     @db.Text
  metadata                 Json?
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  post                     CommunityPost               @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor                    AuthUser?                   @relation("CommunityModerationActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([postId, createdAt(sort: Desc)], map: "post_moderation_events_post_created_idx")
  @@map("post_moderation_events")
  @@schema("community")
}

// ---------------------------------------------------------------------------
// tourism — place profiles overlay (reviews live in community).
// Sources:
//   20260917030000_tourism_reviews_ranking_foundation.sql
//   20260917024448_tourism_taxonomy_and_ranking_inputs.sql
// tourism_type_id FK -> ref.ref_tourism_types; season_mode is TEXT + CHECK.
// ---------------------------------------------------------------------------

model TourismPlaceProfile {
  placeId            BigInt   @id @map("place_id")
  tourismTypeId      BigInt   @map("tourism_type_id")
  shortDescription   String?  @map("short_description") @db.Text
  priceLevel         Int?     @map("price_level")
  editorPick         Boolean  @default(false) @map("editor_pick")
  isPublic           Boolean  @default(true) @map("is_public")
  editorialScore     Int      @default(50) @map("editorial_score")
  manualBoost        Int      @default(0) @map("manual_boost")
  seasonMode         String   @default("all_year") @map("season_mode") @db.Text
  seasonStartMonth   Int?     @map("season_start_month")
  seasonEndMonth     Int?     @map("season_end_month")
  createdBy          BigInt?  @map("created_by")
  updatedBy          BigInt?  @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  place              CorePlace      @relation(fields: [placeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tourismType        RefTourismType @relation(fields: [tourismTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser      AuthUser?      @relation("TourismProfileCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser      AuthUser?      @relation("TourismProfileUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tourismTypeId], map: "place_profiles_tourism_type_id_idx")
  @@index([createdAt(sort: Desc)], map: "place_profiles_created_at_idx")
  @@map("place_profiles")
  @@schema("tourism")
}

model TourismRankingConfig {
  id                BigInt   @id @default(autoincrement())
  scopeType         String   @map("scope_type") @db.Text
  algorithmVersion  String   @map("algorithm_version") @db.Text
  editorialWeight   Decimal  @map("editorial_weight") @db.Decimal(6, 4)
  importanceWeight  Decimal  @map("importance_weight") @db.Decimal(6, 4)
  reviewWeight      Decimal  @map("review_weight") @db.Decimal(6, 4)
  popularityWeight  Decimal  @map("popularity_weight") @db.Decimal(6, 4)
  effectiveFrom     DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([algorithmVersion, scopeType], map: "ranking_configs_version_idx")
  @@map("ranking_configs")
  @@schema("tourism")
}

/** Curator-ignored tourism candidates — prevents reappearance in candidate lists. */
model TourismPlaceCandidateIgnore {
  placeId    BigInt    @id @map("place_id")
  ignoredBy  BigInt?   @map("ignored_by")
  reason     String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  place         CorePlace @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ignoredByUser AuthUser? @relation("TourismCandidateIgnoredBy", fields: [ignoredBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt(sort: Desc)], map: "place_candidate_ignores_created_at_idx")
  @@map("place_candidate_ignores")
  @@schema("tourism")
}

// ---------------------------------------------------------------------------
// tourism activities + events (Phase 1 foundation)
// Source: 20260917110000_tourism_activities_events_foundation.sql
// Festival is ref.ref_event_types.code = festival — no tourism.festivals table.
// ---------------------------------------------------------------------------

model TourismActivity {
  id                      BigInt    @id @default(autoincrement())
  publicId                String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  name                    String    @db.Text
  shortDescription        String?   @map("short_description") @db.Text
  activityTypeId          BigInt    @map("activity_type_id")
  primaryPlaceId          BigInt?   @map("primary_place_id")
  adminAreaId             BigInt    @map("admin_area_id")
  isActive                Boolean   @default(true) @map("is_active")
  isVerified              Boolean   @default(false) @map("is_verified")
  /// Allowed: all_year | best_months | poor_months | temporarily_unavailable
  seasonMode              String    @default("all_year") @map("season_mode") @db.Text
  seasonStartMonth        Int?      @map("season_start_month") @db.SmallInt
  seasonEndMonth          Int?      @map("season_end_month") @db.SmallInt
  displayPriority         Int       @default(0) @map("display_priority")
  requiresScheduleReview  Boolean   @default(false) @map("requires_schedule_review")
  lastScheduleReviewedAt  DateTime? @map("last_schedule_reviewed_at") @db.Timestamptz(6)
  nextReviewDueAt         DateTime? @map("next_review_due_at") @db.Timestamptz(6)
  scheduleReviewNote      String?   @map("schedule_review_note") @db.Text
  createdBy               BigInt?   @map("created_by")
  updatedBy               BigInt?   @map("updated_by")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  activityType   RefActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  primaryPlace   CorePlace?      @relation(fields: [primaryPlaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  adminArea      CoreAdminArea   @relation(fields: [adminAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  advisories     TourismAdvisory[]
  createdByUser  AuthUser?       @relation("TourismActivityCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser  AuthUser?       @relation("TourismActivityUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminAreaId], map: "activities_admin_area_id_idx")
  @@index([activityTypeId], map: "activities_activity_type_id_idx")
  @@map("activities")
  @@schema("tourism")
}

model TourismEvent {
  id                     BigInt    @id @default(autoincrement())
  publicId               String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  name                   String    @db.Text
  shortDescription       String?   @map("short_description") @db.Text
  eventTypeId            BigInt    @map("event_type_id")
  primaryPlaceId         BigInt?   @map("primary_place_id")
  adminAreaId            BigInt    @map("admin_area_id")
  isActive               Boolean   @default(true) @map("is_active")
  isVerified             Boolean   @default(false) @map("is_verified")
  requiresScheduleReview Boolean   @default(false) @map("requires_schedule_review")
  lastScheduleReviewedAt DateTime? @map("last_schedule_reviewed_at") @db.Timestamptz(6)
  nextReviewDueAt        DateTime? @map("next_review_due_at") @db.Timestamptz(6)
  scheduleReviewNote     String?   @map("schedule_review_note") @db.Text
  createdBy              BigInt?   @map("created_by")
  updatedBy              BigInt?   @map("updated_by")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  eventType      RefEventType              @relation(fields: [eventTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  primaryPlace   CorePlace?                @relation(fields: [primaryPlaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  adminArea      CoreAdminArea             @relation(fields: [adminAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  occurrences    TourismEventOccurrence[]
  advisories     TourismAdvisory[]
  createdByUser  AuthUser?                 @relation("TourismEventCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser  AuthUser?                 @relation("TourismEventUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminAreaId], map: "events_admin_area_id_idx")
  @@index([eventTypeId], map: "events_event_type_id_idx")
  @@map("events")
  @@schema("tourism")
}

model TourismEventOccurrence {
  id            BigInt    @id @default(autoincrement())
  publicId      String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  eventId       BigInt    @map("event_id")
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(6)
  /// Allowed: scheduled | confirmed | cancelled | completed
  status        String    @default("scheduled") @db.Text
  scheduleNote  String?   @map("schedule_note") @db.Text
  sourceUrl     String?   @map("source_url") @db.Text
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  createdBy     BigInt?   @map("created_by")
  updatedBy     BigInt?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  event         TourismEvent @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser AuthUser?    @relation("TourismEventOccurrenceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser AuthUser?    @relation("TourismEventOccurrenceUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([eventId], map: "event_occurrences_event_id_idx")
  @@index([startsAt], map: "event_occurrences_starts_at_idx")
  @@index([endsAt], map: "event_occurrences_ends_at_idx")
  @@index([status], map: "event_occurrences_status_idx")
  @@map("event_occurrences")
  @@schema("tourism")
}

// ---------------------------------------------------------------------------
// tourism foods / guides / advisories / research staging (Phase 1)
// Source: 20260921120000_tourism_foods_guides_advisories_research.sql
// Foods are dishes, not restaurants. research_candidates is unverified staging.
// ---------------------------------------------------------------------------

model TourismFood {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  name             String    @db.Text
  nameEn           String?   @map("name_en") @db.Text
  nameMm           String?   @map("name_mm") @db.Text
  shortDescription String?   @map("short_description") @db.Text
  /// Allowed: dish | snack | dessert | drink | specialty | other
  foodType         String    @map("food_type") @db.Text
  /// Allowed labels: signature | must_try | popular | traditional | local_specialty | street_food | seasonal
  labels           String[]  @default([])
  adminAreaId      BigInt    @map("admin_area_id")
  isActive         Boolean   @default(true) @map("is_active")
  isVerified       Boolean   @default(false) @map("is_verified")
  sourceUrl        String?   @map("source_url") @db.Text
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  createdBy        BigInt?   @map("created_by")
  updatedBy        BigInt?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  adminArea     CoreAdminArea         @relation(fields: [adminAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  placeLinks    TourismFoodPlaceLink[]
  createdByUser AuthUser?             @relation("TourismFoodCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser AuthUser?             @relation("TourismFoodUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminAreaId], map: "foods_admin_area_id_idx")
  @@map("foods")
  @@schema("tourism")
}

model TourismFoodPlaceLink {
  id               BigInt    @id @default(autoincrement())
  foodId           BigInt    @map("food_id")
  placeId          BigInt    @map("place_id")
  availabilityNote String?   @map("availability_note") @db.Text
  isSignatureHere  Boolean   @default(false) @map("is_signature_here")
  isVerified       Boolean   @default(false) @map("is_verified")
  sourceUrl        String?   @map("source_url") @db.Text
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  food  TourismFood @relation(fields: [foodId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  place CorePlace   @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([foodId, placeId], map: "food_place_links_food_place_key")
  @@index([foodId], map: "food_place_links_food_id_idx")
  @@index([placeId], map: "food_place_links_place_id_idx")
  @@map("food_place_links")
  @@schema("tourism")
}

model TourismLocalGuide {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  adminAreaId      BigInt    @map("admin_area_id")
  placeId          BigInt?   @map("place_id")
  /// Allowed: culture | craft | local_product | food_culture | etiquette | visitor_tip | practical_info | other
  guideType        String    @map("guide_type") @db.Text
  title            String    @db.Text
  shortDescription String?   @map("short_description") @db.Text
  content          String    @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  isVerified       Boolean   @default(false) @map("is_verified")
  sourceUrl        String?   @map("source_url") @db.Text
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  createdBy        BigInt?   @map("created_by")
  updatedBy        BigInt?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  adminArea     CoreAdminArea @relation(fields: [adminAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  place         CorePlace?    @relation(fields: [placeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdByUser AuthUser?     @relation("TourismLocalGuideCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser AuthUser?     @relation("TourismLocalGuideUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminAreaId], map: "local_guides_admin_area_id_idx")
  @@index([placeId], map: "local_guides_place_id_idx")
  @@map("local_guides")
  @@schema("tourism")
}

model TourismAdvisory {
  id             BigInt    @id @default(autoincrement())
  publicId       String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  adminAreaId    BigInt    @map("admin_area_id")
  placeId        BigInt?   @map("place_id")
  activityId     BigInt?   @map("activity_id")
  eventId        BigInt?   @map("event_id")
  /// Allowed: access | seasonal | closure | safety | etiquette | transport | weather | payment | visitor_requirement | other
  advisoryType   String    @map("advisory_type") @db.Text
  title          String    @db.Text
  description    String    @db.Text
  /// Allowed: info | caution | important
  severity       String    @db.Text
  effectiveFrom  DateTime? @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")
  isVerified     Boolean   @default(false) @map("is_verified")
  sourceUrl      String?   @map("source_url") @db.Text
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  createdBy      BigInt?   @map("created_by")
  updatedBy      BigInt?   @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  adminArea     CoreAdminArea    @relation(fields: [adminAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  place         CorePlace?       @relation(fields: [placeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activity      TourismActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  event         TourismEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdByUser AuthUser?        @relation("TourismAdvisoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser AuthUser?        @relation("TourismAdvisoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminAreaId], map: "advisories_admin_area_id_idx")
  @@index([placeId], map: "advisories_place_id_idx")
  @@map("advisories")
  @@schema("tourism")
}

/** Unverified AI/human research staging — not public production tourism data. */
model TourismResearchCandidate {
  id                    BigInt    @id @default(autoincrement())
  publicId              String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  adminAreaId           BigInt    @map("admin_area_id")
  /// Allowed: attraction | activity | event | food | food_place | local_guide | advisory | other
  entityType            String    @map("entity_type") @db.Text
  name                  String    @db.Text
  /// Allowed: new | reviewing | added | rejected | needs_research
  researchStatus        String    @default("new") @map("research_status") @db.Text
  evidenceConfidence    Int?      @map("evidence_confidence") @db.SmallInt
  normalizedPayload     Json      @map("normalized_payload") @db.JsonB
  researchProvider      String    @map("research_provider") @db.Text
  researchRunId         String?   @map("research_run_id") @db.Text
  /// Stable key within research_run_id for idempotent imports
  candidateKey          String?   @map("candidate_key") @db.Text
  researchedAt          DateTime  @map("researched_at") @db.Timestamptz(6)
  reviewedBy            BigInt?   @map("reviewed_by")
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdEntityType     String?   @map("created_entity_type") @db.Text
  createdEntityPublicId String?   @map("created_entity_public_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  adminArea      CoreAdminArea @relation(fields: [adminAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedByUser AuthUser?     @relation("TourismResearchCandidateReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminAreaId, researchStatus], map: "research_candidates_admin_area_status_idx")
  @@index([entityType], map: "research_candidates_entity_type_idx")
  @@map("research_candidates")
  @@schema("tourism")
}

model CommunityPlaceReview {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  placeId         BigInt    @map("place_id")
  userId          BigInt    @map("user_id")
  rating          Int
  title           String?   @db.Text
  body            String?   @db.Text
  /// Allowed: pending | published | rejected | hidden | deleted (DB CHECK).
  status          String    @default("pending") @db.Text
  moderationNote  String?   @map("moderation_note") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)

  place           CorePlace @relation(fields: [placeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            AuthUser  @relation("CommunityPlaceReviewAuthor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moderationEvents CommunityReviewModerationEvent[]

  @@index([placeId], map: "place_reviews_place_id_idx")
  @@index([userId], map: "place_reviews_user_id_idx")
  @@index([status], map: "place_reviews_status_idx")
  @@index([createdAt(sort: Desc)], map: "place_reviews_created_at_idx")
  @@map("place_reviews")
  @@schema("community")
}

model CommunityReviewModerationEvent {
  id          BigInt    @id @default(autoincrement())
  reviewId    BigInt    @map("review_id")
  actorUserId BigInt?   @map("actor_user_id")
  /// Same allowed set as place_reviews.status (DB CHECK).
  fromStatus  String    @map("from_status") @db.Text
  toStatus    String    @map("to_status") @db.Text
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  review      CommunityPlaceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor       AuthUser?            @relation("CommunityReviewModerationActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([reviewId, createdAt(sort: Desc)], map: "review_moderation_events_review_created_idx")
  @@index([createdAt(sort: Desc)], map: "review_moderation_events_created_at_idx")
  @@map("review_moderation_events")
  @@schema("community")
}

model CommunityPlaceRatingSummary {
  placeId               BigInt    @id @map("place_id")
  publishedReviewCount  Int       @default(0) @map("published_review_count")
  averageRating         Decimal?  @map("average_rating") @db.Decimal(4, 2)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  place                 CorePlace @relation(fields: [placeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([updatedAt(sort: Desc)], map: "place_rating_summaries_updated_at_idx")
  @@map("place_rating_summaries")
  @@schema("community")
}
