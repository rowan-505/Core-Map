# Copy to apps/api/.env. Never commit real secrets.
# Optional: apps/api/.env.local overrides .env for localhost auth/OAuth
# (loaded only when NODE_ENV !== production). Never commit .env.local.
# Same keys as a local API env. Fill secrets yourself.

HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB
# Prisma client pool size when DATABASE_URL has no connection_limit=…
# Default in code is 8 (map reverse uses ≤2 connections per request).
# Use 3 on very tight Supabase session poolers; do not set 1 for public map API.
# PRISMA_CONNECTION_LIMIT=8

# Prefer AUTH_JWT_SECRET. JWT_SECRET remains a fallback alias.
AUTH_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_JWT_ISS=http://localhost:3001
AUTH_JWT_AUD=coremap
AUTH_BYPASS=false
AUTH_MFA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Production: cryptographically random ≥32 bytes (e.g. `openssl rand -hex 32`).
# Do not reuse AUTH_JWT_SECRET or a weak passphrase.

# ---------------------------------------------------------------------------
# Public app URLs (OAuth return allowlist uses these origins only)
# Local defaults:
API_PUBLIC_URL=http://localhost:3001
WEB_APP_URL=http://localhost:5173
DASHBOARD_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
# Production (set these in the host env; do not commit secrets):
# API_PUBLIC_URL=https://api.coremapmm.com
# WEB_APP_URL=https://map.coremapmm.com
# DASHBOARD_APP_URL=https://admin.coremapmm.com
# OAuth callbacks stay on the API host. Map/Dashboard are return destinations only.

# Google OAuth (leave empty to disable). Local callback:
# http://localhost:3001/auth/oauth/google/callback
# Production callback:
# https://api.coremapmm.com/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback
# Production example:
# GOOGLE_OAUTH_REDIRECT_URI=https://api.coremapmm.com/auth/oauth/google/callback

# Facebook OAuth is deferred for the current production release.
# Keep false unless you are actively testing Facebook locally.
# Production release must keep:
FACEBOOK_OAUTH_ENABLED=false
# Local Facebook testing:
# FACEBOOK_OAUTH_ENABLED=true
# Facebook secrets are required only when FACEBOOK_OAUTH_ENABLED=true.
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3001/auth/oauth/facebook/callback
# Production (only after Meta App Review / publish):
# FACEBOOK_OAUTH_REDIRECT_URI=https://api.coremapmm.com/auth/oauth/facebook/callback
# See docs/roadmap.md → "Facebook OAuth — deferred to later release"

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
TILE_SERVER_URL=http://localhost:3002

ROUTING_ENABLED=false
ROUTING_DEFAULT_ENGINE=valhalla
VALHALLA_BASE_URL=http://localhost:8002
ROUTING_REQUEST_TIMEOUT_MS=8000
ROUTING_PUBLIC_PROFILES=walk,car,motorcycle

# Local Basemap admin bridge (Windows/WSL only). Hard-disabled when NODE_ENV=production.
# ENABLE_LOCAL_BASEMAP_ADMIN=true
# LOCAL_TILE_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/coremap_tiles

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_OTP_SECRET=
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_MEDIA_PRIVATE_BUCKET=
R2_MEDIA_PUBLIC_BUCKET=
R2_MEDIA_PUBLIC_BASE_URL=

# Prebuilt field bootstrap gzip (generated offline). GET /field/bootstrap never rebuilds it.
# Local dir for tests/dev. Production can use the private R2 bucket (field/bootstrap/*).
FIELD_BOOTSTRAP_SNAPSHOT_DIR=
# Privacy-safe RSS/heap/timing logs for bootstrap. Never logs bodies or geometry.
FIELD_BOOTSTRAP_METRICS=false
