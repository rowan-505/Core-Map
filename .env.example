# Copy to `.env` in the repo root. Never commit real secrets.
# apps/api/.env overrides these keys when both are set.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB
LOCAL_RAW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB

# Windows/WSL PMTiles machine — use explicit names (do not reuse one URL for both)
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
LOCAL_TILE_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/coremap_tiles
# Alias accepted by tile scripts if LOCAL_TILE_DATABASE_URL is unset:
# COREMAP_TILES_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/coremap_tiles

# Windows/WSL promote/demote-to-Core CLI (tiles:promote-building, tiles:promote-land, tiles:demote-building)
# Calls the existing Fastify admin API — do not put a Supabase service-role key here.
COREMAP_API_BASE_URL=http://localhost:3001
COREMAP_ADMIN_EMAIL=admin@example.com
COREMAP_ADMIN_PASSWORD=change-me
# Optional: skip login when you already have a dashboard JWT
# COREMAP_ACCESS_TOKEN=

# Optional: township tourism Deep Research runner (scripts/tourism-research only; not used by Fastify).
# Get a key from Google AI Studio. Never commit real keys.
# GEMINI_API_KEY=
# TOURISM_RESEARCH_AGENT=deep-research-max-preview-04-2026
# TOURISM_NORMALIZE_MODEL=gemini-3.1-flash-lite
# TOURISM_RESEARCH_CONCURRENCY=2
